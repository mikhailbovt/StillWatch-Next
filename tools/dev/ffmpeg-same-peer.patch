+static int same_numeric_address(const char *a, const char *b)
+{
+    uint8_t left[16], right[16];
+    if (inet_pton(AF_INET, a, left) == 1)
+        return inet_pton(AF_INET, b, right) == 1 && !memcmp(left, right, 4);
+    return inet_pton(AF_INET6, a, left) == 1 &&
+           inet_pton(AF_INET6, b, right) == 1 && !memcmp(left, right, 16);
+}
