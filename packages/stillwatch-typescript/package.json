{
  "name": "@stillwatch/sdk",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {"node": ">=24.12"},
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./node": {"types": "./dist/node.d.ts", "import": "./dist/node.js"}
  },
  "files": ["dist"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsc --project tsconfig.json",
    "test": "npm run generate:check && npm run build && node --test"
  },
  "dependencies": {"undici": "8.12.4"},
  "devDependencies": {
    "@types/node": "24.13.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  }
}
