{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CameraPatch",
  "type": "object",
  "properties": {
    "cloud_consent": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "controlled_fire_regions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ControlledFireRegion"
      }
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "privacy_masks": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/MaskRect"
      }
    },
    "sampling": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraSampling"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraSource"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CameraSampling": {
      "type": "object",
      "properties": {
        "evidence_fps": {
          "type": "integer",
          "format": "uint8",
          "maximum": 5,
          "minimum": 1
        },
        "fire_fps": {
          "type": "integer",
          "format": "uint8",
          "maximum": 2,
          "minimum": 1
        },
        "pose_fps": {
          "type": "integer",
          "format": "uint8",
          "maximum": 5,
          "minimum": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "pose_fps",
        "fire_fps",
        "evidence_fps"
      ]
    },
    "CameraSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "pace": {
              "type": "boolean"
            },
            "repeat": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "replay"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file",
            "pace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "credential_ref": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "peer": {
              "type": "string"
            },
            "secure": {
              "type": "boolean"
            },
            "stream_path": {
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/RtspTransport"
            },
            "type": {
              "type": "string",
              "const": "rtsp"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "peer",
            "stream_path",
            "secure",
            "transport"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "usb"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "device_id"
          ]
        }
      ]
    },
    "ControlledFireRegion": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ControlledMode"
        },
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegionPoint"
          },
          "maxItems": 16,
          "minItems": 3
        },
        "source": {
          "$ref": "#/$defs/ControlledSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "mode",
        "polygon"
      ]
    },
    "ControlledMode": {
      "type": "string",
      "enum": [
        "steady",
        "intermittent"
      ]
    },
    "ControlledSource": {
      "type": "string",
      "enum": [
        "burner",
        "candle",
        "fireplace",
        "grill"
      ]
    },
    "MaskRect": {
      "type": "object",
      "properties": {
        "bottom": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "left": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "top": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "RegionPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "RtspTransport": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    }
  }
}
