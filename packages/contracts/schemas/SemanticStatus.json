{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticStatus",
  "type": "object",
  "properties": {
    "cloud_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "daily_request_limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "last_inference_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_model_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "sdk_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "$ref": "#/$defs/SemanticState"
    },
    "used_today": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "state",
    "used_today",
    "daily_request_limit"
  ],
  "$defs": {
    "SemanticState": {
      "type": "string",
      "enum": [
        "disabled",
        "connecting",
        "available",
        "degraded"
      ]
    }
  }
}
