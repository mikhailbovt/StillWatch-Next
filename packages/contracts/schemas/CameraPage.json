{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CameraPage",
  "type": "object",
  "properties": {
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Camera"
      }
    },
    "next": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "cameras"
  ],
  "$defs": {
    "AnalysisCadence": {
      "type": "object",
      "properties": {
        "below_target": {
          "type": "boolean"
        },
        "fire_frames_per_minute": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fire_target_per_minute": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pose_frames_per_minute": {
          "description": "Accepted model results in the last ten seconds, normalized by source time.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pose_target_per_minute": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "pose_frames_per_minute",
        "fire_frames_per_minute",
        "pose_target_per_minute",
        "fire_target_per_minute",
        "below_target"
      ]
    },
    "AnalysisState": {
      "type": "string",
      "enum": [
        "disabled",
        "starting",
        "ready",
        "degraded"
      ]
    },
    "AnalysisStatus": {
      "type": "object",
      "properties": {
        "cadence": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisCadence"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra_fire_frames": {
          "description": "Accepted fire inferences dispatched ahead of the configured base interval.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "fire_frames": {
          "$ref": "#/$defs/Counter"
        },
        "fire_regions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "last_analysis_age_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_queue_age_ms": {
          "description": "Time between receiving the last accepted frame and dispatching it to a worker.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "last_worker_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "people": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "pose_frames": {
          "$ref": "#/$defs/Counter"
        },
        "smoke_regions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "source_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/AnalysisState"
        }
      },
      "required": [
        "state",
        "pose_frames",
        "fire_frames"
      ]
    },
    "Camera": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/CameraConfig"
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dimensions"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "live": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "runtime": {
          "$ref": "#/$defs/CameraRuntime"
        },
        "scene_review": {
          "$ref": "#/$defs/SceneReview"
        },
        "scene_revision": {
          "$ref": "#/$defs/Counter"
        },
        "source_epoch": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "id",
        "revision",
        "scene_revision",
        "source_epoch",
        "live",
        "config",
        "scene_review",
        "runtime"
      ]
    },
    "CameraConfig": {
      "type": "object",
      "properties": {
        "cloud_consent": {
          "description": "Allows semantic evidence from this camera to be sent to Firebase AI Logic.",
          "type": "boolean"
        },
        "controlled_fire_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlledFireRegion"
          },
          "maxItems": 16
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/CameraPriority"
        },
        "privacy_masks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MaskRect"
          }
        },
        "sampling": {
          "description": "Omit to use 5 pose, 2 fire and 5 evidence frames per second.",
          "$ref": "#/$defs/CameraSampling"
        },
        "source": {
          "$ref": "#/$defs/CameraSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "enabled",
        "source"
      ]
    },
    "CameraPriority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ]
    },
    "CameraRuntime": {
      "type": "object",
      "properties": {
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "dropped": {
          "$ref": "#/$defs/Counter"
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_frame_age_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeated_frame": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/CaptureState"
        }
      },
      "required": [
        "state",
        "dropped"
      ]
    },
    "CameraSampling": {
      "type": "object",
      "properties": {
        "evidence_fps": {
          "type": "integer",
          "format": "uint8",
          "maximum": 5,
          "minimum": 1
        },
        "fire_fps": {
          "type": "integer",
          "format": "uint8",
          "maximum": 2,
          "minimum": 1
        },
        "pose_fps": {
          "type": "integer",
          "format": "uint8",
          "maximum": 5,
          "minimum": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "pose_fps",
        "fire_fps",
        "evidence_fps"
      ]
    },
    "CameraSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "pace": {
              "type": "boolean"
            },
            "repeat": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "replay"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "file",
            "pace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "credential_ref": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "peer": {
              "type": "string"
            },
            "secure": {
              "type": "boolean"
            },
            "stream_path": {
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/RtspTransport"
            },
            "type": {
              "type": "string",
              "const": "rtsp"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "peer",
            "stream_path",
            "secure",
            "transport"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "usb"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "device_id"
          ]
        }
      ]
    },
    "CaptureState": {
      "type": "string",
      "enum": [
        "disabled",
        "starting",
        "replaying",
        "streaming",
        "clock_hold",
        "completed",
        "retrying",
        "unavailable",
        "capacity_exceeded"
      ]
    },
    "ControlledFireRegion": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ControlledMode"
        },
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegionPoint"
          },
          "maxItems": 16,
          "minItems": 3
        },
        "source": {
          "$ref": "#/$defs/ControlledSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "mode",
        "polygon"
      ]
    },
    "ControlledMode": {
      "type": "string",
      "enum": [
        "steady",
        "intermittent"
      ]
    },
    "ControlledSource": {
      "type": "string",
      "enum": [
        "burner",
        "candle",
        "fireplace",
        "grill"
      ]
    },
    "Counter": {
      "description": "Canonical decimal u64 in 0..=18446744073709551615. Range is checked by the parser.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Dimensions": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "MaskRect": {
      "type": "object",
      "properties": {
        "bottom": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "left": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "top": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "RegionPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "RtspTransport": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "SceneReview": {
      "type": "string",
      "enum": [
        "unconfigured",
        "needs_review",
        "confirmed"
      ]
    }
  }
}
