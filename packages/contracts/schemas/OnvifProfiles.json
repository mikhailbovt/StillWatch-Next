{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_OnvifProfile",
  "type": "array",
  "items": {
    "$ref": "#/$defs/OnvifProfile"
  },
  "$defs": {
    "OnvifMedia": {
      "type": "string",
      "enum": [
        "media1",
        "media2"
      ]
    },
    "OnvifProfile": {
      "type": "object",
      "properties": {
        "media": {
          "$ref": "#/$defs/OnvifMedia"
        },
        "name": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "media",
        "token",
        "name"
      ]
    }
  }
}
