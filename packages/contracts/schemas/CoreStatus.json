{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreStatus",
  "type": "object",
  "properties": {
    "camera_coverage": {
      "description": "Bounded local snapshot sized by the camera registry.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/CameraCoverage"
      }
    },
    "inference": {
      "$ref": "#/$defs/InferenceStatus"
    },
    "media": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string"
    },
    "writer": {
      "anyOf": [
        {
          "$ref": "#/$defs/WriterStatus"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "inference"
  ],
  "$defs": {
    "AnalysisCoverage": {
      "type": "object",
      "properties": {
        "fire_frames": {
          "$ref": "#/$defs/Counter"
        },
        "last_analysis_age_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "pose_frames": {
          "$ref": "#/$defs/Counter"
        },
        "state": {
          "$ref": "#/$defs/AnalysisState"
        },
        "wall_cadence": {
          "anyOf": [
            {
              "$ref": "#/$defs/WallCadence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "pose_frames",
        "fire_frames"
      ]
    },
    "AnalysisState": {
      "type": "string",
      "enum": [
        "disabled",
        "starting",
        "ready",
        "degraded"
      ]
    },
    "CameraCoverage": {
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisCoverage"
        },
        "camera_id": {
          "type": "string",
          "format": "uuid"
        },
        "capture_state": {
          "$ref": "#/$defs/CaptureState"
        },
        "current_source_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_frame_age_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "source_lagging": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "camera_id",
        "revision",
        "capture_state",
        "analysis"
      ]
    },
    "CaptureState": {
      "type": "string",
      "enum": [
        "disabled",
        "starting",
        "replaying",
        "streaming",
        "clock_hold",
        "completed",
        "retrying",
        "unavailable",
        "capacity_exceeded"
      ]
    },
    "Counter": {
      "description": "Canonical decimal u64 in 0..=18446744073709551615. Range is checked by the parser.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "InferenceBackend": {
      "type": "string",
      "enum": [
        "cpu",
        "cuda",
        "unrecognized"
      ]
    },
    "InferenceCounts": {
      "type": "object",
      "properties": {
        "fire": {
          "$ref": "#/$defs/TaskCounts"
        },
        "pose": {
          "$ref": "#/$defs/TaskCounts"
        }
      },
      "required": [
        "pose",
        "fire"
      ]
    },
    "InferenceFailure": {
      "type": "string",
      "enum": [
        "model_pack_unavailable",
        "model_initialization_failed",
        "runtime_unavailable",
        "worker_unavailable",
        "worker_timeout",
        "worker_failed",
        "evidence_backpressure",
        "unrecognized"
      ]
    },
    "InferenceStatus": {
      "type": "object",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceBackend"
            },
            {
              "type": "null"
            }
          ]
        },
        "configured_workers": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "ready_workers": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/AnalysisState"
        },
        "totals": {
          "description": "Task totals since Core started. Visible to the owner.",
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceCounts"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "ready_workers",
        "configured_workers"
      ]
    },
    "MediaStatus": {
      "type": "object",
      "properties": {
        "redacted_transcode": {
          "type": "boolean"
        },
        "router_ready": {
          "type": "boolean"
        },
        "video_codec": {
          "type": "string"
        }
      },
      "required": [
        "router_ready",
        "video_codec",
        "redacted_transcode"
      ]
    },
    "TaskCounts": {
      "type": "object",
      "properties": {
        "accepted": {
          "$ref": "#/$defs/Counter"
        },
        "cancelled": {
          "$ref": "#/$defs/Counter"
        },
        "dispatched": {
          "$ref": "#/$defs/Counter"
        },
        "intentional_burst": {
          "description": "Accepted results from intentionally early Fire dispatches.",
          "$ref": "#/$defs/Counter"
        },
        "missed_source_slots": {
          "description": "Skipped base slots before a dispatch and rejected base claims within one source clock.",
          "$ref": "#/$defs/Counter"
        },
        "rejected_generation": {
          "$ref": "#/$defs/Counter"
        },
        "rejected_scope": {
          "$ref": "#/$defs/Counter"
        },
        "rejected_stale": {
          "$ref": "#/$defs/Counter"
        },
        "timeout": {
          "$ref": "#/$defs/Counter"
        },
        "worker_failed": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "dispatched",
        "accepted",
        "timeout",
        "worker_failed",
        "cancelled",
        "rejected_stale",
        "rejected_scope",
        "rejected_generation",
        "missed_source_slots",
        "intentional_burst"
      ]
    },
    "WallCadence": {
      "type": "object",
      "properties": {
        "fire_accepted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pose_accepted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "window_seconds": {
          "description": "Accepted results in the trailing monotonic clock interval.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "window_seconds",
        "pose_accepted",
        "fire_accepted"
      ]
    },
    "WriterStatus": {
      "type": "object",
      "properties": {
        "cancelled_queued": {
          "$ref": "#/$defs/Counter"
        },
        "completed": {
          "$ref": "#/$defs/Counter"
        },
        "maximum_operation_ms": {
          "$ref": "#/$defs/Counter"
        },
        "maximum_queue_wait_ms": {
          "$ref": "#/$defs/Counter"
        },
        "oldest_queued_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "queue_capacity": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "queue_high_water": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "queued": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "rejected_queue_full": {
          "$ref": "#/$defs/Counter"
        },
        "running_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "queue_capacity",
        "queued",
        "queue_high_water",
        "completed",
        "rejected_queue_full",
        "cancelled_queued",
        "maximum_queue_wait_ms",
        "maximum_operation_ms"
      ]
    }
  }
}
