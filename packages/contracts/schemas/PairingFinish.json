  "title": "PairingFinish",
  "type": "object",
  "properties": {
    "challenge": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "public_key": {
      "type": "string"
    },
    "secret": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false,
