{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayUpload",
  "type": "object",
  "properties": {
    "bytes": {
      "$ref": "#/$defs/Counter"
    },
    "file": {
      "type": "string"
    },
    "source_probe": {
      "$ref": "#/$defs/SourceProbe"
    }
  },
  "required": [
    "file",
    "bytes",
    "source_probe"
  ],
  "$defs": {
    "Counter": {
      "description": "Canonical decimal u64 in 0..=18446744073709551615. Range is checked by the parser.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Dimensions": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "SourceProbe": {
      "type": "object",
      "properties": {
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "live": {
          "type": "boolean"
        },
        "native_pts": {
          "type": "boolean"
        }
      },
      "required": [
        "dimensions",
        "live",
        "native_pts"
      ]
    }
  }
}
