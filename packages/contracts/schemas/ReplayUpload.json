{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayUpload",
  "type": "object",
  "properties": {
    "bytes": {
      "$ref": "#/$defs/Counter"
    },
    "file": {
      "type": "string"
    },
    "source_probe": {
      "$ref": "#/$defs/SourceProbe"
    }
  },
  "required": [
    "file",
    "bytes",
    "source_probe"
  ],
  "$defs": {
    "CaptureCapacity": {
      "type": "object",
      "properties": {
        "available_camera_slots": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "available_raw_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fits": {
          "type": "boolean"
        },
        "required_raw_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "fits",
        "available_camera_slots",
        "available_raw_bytes",
        "required_raw_bytes"
      ]
    },
    "Counter": {
      "description": "Canonical decimal u64 in 0..=18446744073709551615. Range is checked by the parser.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Dimensions": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "MainStreamProbe": {
      "type": "object",
      "properties": {
        "codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "native_pts": {
          "type": "boolean"
        }
      },
      "required": [
        "dimensions",
        "native_pts"
      ]
    },
    "SourceProbe": {
      "type": "object",
      "properties": {
        "capture_capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureCapacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "live": {
          "type": "boolean"
        },
        "main_stream": {
          "anyOf": [
            {
              "$ref": "#/$defs/MainStreamProbe"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_pts": {
          "type": "boolean"
        }
      },
      "required": [
        "dimensions",
        "live",
        "native_pts"
      ]
    }
  }
}
