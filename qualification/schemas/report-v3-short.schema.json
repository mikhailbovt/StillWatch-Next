{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StillWatch Fast RC v3 Short validator report",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "run_id", "candidate_digest", "profile_digest", "run_manifest_digest", "native_wall_seconds", "source_video_seconds", "virtual_clock_span_seconds", "verdict", "criteria", "coverage", "limitations", "scope", "contract_digests", "not_established_by_this_run"],
  "properties": {
    "protocol": {"const": "fast-rc-v3-short"},
    "scope": {"const": "finite-native-engineering"},
    "contract_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "quality", "release"],
      "properties": {
        "native": {"$ref": "#/$defs/digest"},
        "quality": {"$ref": "#/$defs/digest"},
        "release": {"$ref": "#/$defs/digest"}
      }
    },
    "not_established_by_this_run": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "execution_profile_digest": {"$ref": "#/$defs/digest"},
    "active_model_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_spec_sha256", "artifact_validation", "active_profile_numeric", "active_profile_observations", "active_profile_events", "full_pack_numeric"],
      "properties": {
        "observation_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifact_validation": {"enum": ["pass", "fail", "not_run"]},
        "active_profile_numeric": {"enum": ["pass", "fail", "not_run"]},
        "active_profile_observations": {"enum": ["pass", "fail", "not_run"]},
        "active_profile_events": {"enum": ["pass", "fail", "not_run"]},
        "full_pack_numeric": {"enum": ["pass", "fail", "not_run"]}
      }
    },
    "run_manifest_digest": {"$ref": "#/$defs/digest"},
    "native_wall_seconds": {"$ref": "#/$defs/duration"},
    "source_video_seconds": {"$ref": "#/$defs/duration"},
    "virtual_clock_span_seconds": {"$ref": "#/$defs/duration"},
    "verdict": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "criteria": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_cases", "completed_cases"],
      "properties": {
        "required_cases": {"type": "integer", "minimum": 1},
        "completed_cases": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "required": ["execution_profile_digest", "active_model_results"],
        "properties": {
          "native_wall_seconds": {"type": "number", "minimum": 720, "maximum": 2700},
          "criteria": {"items": {"properties": {"result": {"const": "PASS"}}}}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "FAIL"}}},
      "then": {"properties": {"criteria": {"contains": {"properties": {"result": {"const": "FAIL"}}}}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "INCOMPLETE"}}},
      "then": {
        "properties": {
          "criteria": {
            "contains": {"properties": {"result": {"enum": ["NOT_RUN", "INCOMPLETE"]}}},
            "items": {"properties": {"result": {"enum": ["PASS", "NOT_RUN", "INCOMPLETE"]}}}
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "duration": {"type": ["number", "null"], "minimum": 0},
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "observed", "result", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "required": {"type": "object", "minProperties": 1},
        "observed": {"type": ["object", "null"]},
        "result": {"enum": ["PASS", "FAIL", "INCOMPLETE", "NOT_RUN"]},
        "evidence": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 512},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      },
      "if": {"properties": {"result": {"enum": ["PASS", "FAIL"]}}},
      "then": {"properties": {"observed": {"type": "object", "minProperties": 1}, "evidence": {"minItems": 1}}}
    }
  }
}
