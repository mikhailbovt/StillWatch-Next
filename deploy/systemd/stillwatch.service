[Unit]
Description=StillWatch Core
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=stillwatch
Group=stillwatch
StateDirectory=stillwatch
StateDirectoryMode=0700
EnvironmentFile=-/etc/stillwatch/core.conf
ExecStart=/usr/bin/stillwatch-core
Restart=on-failure
RestartSec=3s
WatchdogSec=30s
TimeoutStopSec=15s
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
