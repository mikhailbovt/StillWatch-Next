<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="StillWatch Companion" Manufacturer="StillWatch" Version="0.1.0"
          UpgradeCode="9095D1C4-7158-4B94-AE8C-C9259B4D52B1" Compressed="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseUrl="" Theme="hyperlinkLicense" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.CompanionMsi)" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
